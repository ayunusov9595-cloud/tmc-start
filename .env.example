# Database (SQLite for development)
DATABASE_URL="file:./dev.db"

# JWT Secret - CHANGE IN PRODUCTION
JWT_SECRET="tmc-start-dev-jwt-secret-change-in-production"

# Google Gemini API key for AI features (CV review, career guidance, voice transcription)
# Get from: https://aistudio.google.com
# If empty, AI features show "integration not configured" state
GEMINI_API_KEY=""

# OpenAI API key (alternative AI provider)
# OPENAI_API_KEY=""

# Speech-to-text provider: "gemini" | "whisper"
SPEECH_PROVIDER="gemini"

# Environment
NODE_ENV="development"

# File storage
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Branding (configurable)
NEXT_PUBLIC_BRAND_NAME="TMC Start"
NEXT_PUBLIC_INSTITUTE_NAME="TMC Institute"
